{
  "name": "flowcms-app",
  "version": "0.1.1",
  "private": true,
  "description": "FlowCMS — a self-hosted content management system: a public themed site plus an admin panel, with its own API, database and storage.",
  "license": "GPL-2.0-or-later",
  "author": "FlowCMS Tech",
  "homepage": "https://github.com/flowcms-tech/flowcms",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowcms-tech/flowcms.git"
  },
  "bugs": {
    "url": "https://github.com/flowcms-tech/flowcms/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-package.mjs && node scripts/build-example-theme.mjs && node scripts/build-create-flowcms.mjs && vitest run",
    "test:watch": "vitest",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle.config.sqlite.ts",
    "db:generate:postgresql": "drizzle-kit generate --config drizzle.config.postgresql.ts",
    "db:generate:mysql": "drizzle-kit generate --config drizzle.config.mysql.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio:sqlite": "drizzle-kit studio --config drizzle.config.sqlite.ts",
    "db:studio:postgresql": "drizzle-kit studio --config drizzle.config.postgresql.ts",
    "db:studio:mysql": "drizzle-kit studio --config drizzle.config.mysql.ts",
    "db:seed": "bun run src/db/seed.ts",
    "postinstall": "node scripts/copy-tinymce.mjs",
    "db:bootstrap-owner": "node scripts/bootstrap-owner.mjs",
    "build:package": "node scripts/build-package.mjs",
    "build:example-theme": "node scripts/build-example-theme.mjs",
    "build:packages": "node scripts/build-package.mjs && node scripts/build-example-theme.mjs",
    "build:template": "node scripts/build-create-flowcms.mjs"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@auth/drizzle-adapter": "^1.11.2",
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@bprogress/next": "^3.2.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "5.2.2",
    "@libsql/client": "^0.17.4",
    "@napi-rs/canvas": "^1.0.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-table": "^8.21.3",
    "@tinymce/tinymce-react": "^6.3.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^12.40.0",
    "geist": "^1.7.0",
    "googleapis": "^173.0.0",
    "input-otp": "^1.4.2",
    "ioredis": "^6.0.0",
    "laravel-echo": "^2.3.7",
    "lenis": "^1.3.25",
    "lucide-react": "^1.16.0",
    "mysql2": "^3.23.4",
    "next": "16.3.2",
    "next-auth": "^5.0.0-beta.31",
    "postgres": "^3.4.9",
    "pusher-js": "^8.5.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^8.10.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "recharts": "^3",
    "sanitize-html": "^2.17.6",
    "server-only": "^0.0.1",
    "shadcn": "^4.8.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.0",
    "tinymce": "^8.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@example/flowcms-theme-aurora": "file:packages/flowcms-theme-aurora",
    "@clack/prompts": "^1.7.0",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.185.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "flowcms": "file:packages/flowcms",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
